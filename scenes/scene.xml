<?xml version="1.0" encoding="utf-8"?>
<mujoco model="UR5e + Robotiq Hand-E migration">
  <!--
    MuJoCo-native replacement for the supplied Isaac Sim assembly.

    Conventions:
      - lengths: metres
      - angles: radians
      - quaternions exposed by Python: [w, x, y, z]
      - the tcp site is copied from ur5e_cumotion.urdf
      - arm collision spheres are copied from ur5e_cumotion.xrdf
  -->
  <compiler angle="radian" eulerseq="xyz" meshdir="../assets/meshes"
            autolimits="true" inertiafromgeom="false" fusestatic="false"/>
  <option timestep="0.002" integrator="implicitfast" gravity="0 0 -9.81">
    <flag contact="enable"/>
  </option>
  <size njmax="2000" nconmax="500"/>
  <statistic center="0 0 0.35" extent="1.25"/>

  <visual>
    <headlight diffuse="0.75 0.75 0.75" ambient="0.25 0.25 0.25" specular="0.2 0.2 0.2"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="135" elevation="-25"/>
  </visual>

  <default>
    <joint limited="true" damping="1.0" armature="0.01" frictionloss="0.05"/>
    <geom condim="4" friction="0.8 0.02 0.002" solref="0.005 1" solimp="0.9 0.95 0.001"/>
    <default class="visual">
      <geom type="mesh" contype="0" conaffinity="0" group="2" density="0"/>
    </default>
    <default class="collision">
      <!-- Alpha zero keeps planning/physics proxies hidden in the normal view. -->
      <geom contype="1" conaffinity="1" group="3" rgba="0.2 0.9 0.25 0"/>
    </default>
    <default class="arm_joint">
      <joint type="hinge" axis="0 0 1" damping="2.0" armature="0.05"/>
    </default>
    <default class="finger_joint">
      <joint type="slide" damping="4.0" armature="0.005"/>
    </default>
  </default>

